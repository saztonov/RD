# ── Доступ через reverse proxy pro3.fvds.ru (собственный CA) ──────────
# Supabase  : порт 8443, путь-префикс /supabase-ziv  → upstream *.supabase.co
# OpenRouter: порт 8443                               → upstream openrouter.ai
# Chandra/LM: порт 8444                               → upstream ngrok tunnel
SUPABASE_URL=https://pro3.fvds.ru:8443/supabase-ziv
OPENROUTER_BASE_URL=https://pro3.fvds.ru:8443
CHANDRA_BASE_URL=https://pro3.fvds.ru:8444

# TLS: доверие к CA прокси. В контейнере смонтирован в /certs/proxy-ca.pem
# (объединяется с системным бандлом certifi, поэтому datalab.com/R2 тоже работают).
OCR_CA_CERT=/certs/proxy-ca.pem
# OCR_VERIFY_SSL=false        # ТОЛЬКО временная диагностика, не основной режим
# NGROK_PROXY_URL / OCR_PROXY_URL — НЕ нужны для reverse proxy (только forward/squid)

# ── Ключи (значения подставить свои) ──────────────────────────────────
SUPABASE_KEY=
OPENROUTER_API_KEY=
DATALAB_API_KEY=
NGROK_AUTH_USER=
NGROK_AUTH_PASS=

# ── R2 storage ────────────────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# ── Remote OCR server ─────────────────────────────────────────────────
REMOTE_OCR_BASE_URL=https://ocr.fvds.ru
REMOTE_OCR_API_KEY=
